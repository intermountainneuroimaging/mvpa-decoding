{
  "config_version": "1.0",
  "created_by": "AKH",
  "notes": "MVPA operation (maintain/suppress/switch/clear) k-fold classifier, Clearvale working-memory tasks (WMpos/WMneg). Operation windows follow the Nature Communications method: every operation trial contributes its operation period PLUS the inter-trial interval that follows it (up to the next trial's view cue), all shifted by hemodynamic_lag 4.6 s, and, within each subject, every trial is cut to the subject's shortest operation + ITI window (equalize_trial_length: extras removed from the END of the ITI; no separate restriction step -- each subject's model/<subject>_training_trial_length_audit.csv and _summary.csv report every TR cut). Classifier settings are the updated ones from config.clearvale-category-valence-groups.json (one-vs-rest LogisticRegression, liblinear, C = 50, sigmoid evidence, random_state 6100); mask, feature selection, folds and timecourse overlay are from config.clearvale-operation-valence-groups.json. Folds: each fold holds out one pos and one neg run (Clearvale protocols A1|B1|C1|D1 all pair runs [[1,3],[2,4],[5,7],[6,8]]); review before using with other protocols. Every key is commented in config.clearvale-operation-iti-liblinear-kfold.ANNOTATED.md.",

  "event_extraction": {
    "bids_root": "/pl/active/banich/studies/Clearvale/bids/",
    "events_glob": "**/*_events.tsv",
    "derivatives_root": "/pl/active/banich/studies/Clearvale/analysis/bids-hcp/",
    "bold_glob": "sub-{subject}/ses-{session}/func/sub-{subject}_ses-{session}_task-{task}_dir-{dir}_run-{run}_space-MNI152NLin6Asym_desc-preproc_bold.nii.gz",
    "hemodynamic_lag": 4.6,
    "output_file": "master_spreadsheet.csv"
  },

  "model_conditions": {
    "training": {
      "conditions": {
        "maintain": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": ".*maintain.*"}
          ]
        },
        "suppress": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": ".*suppress.*"}
          ]
        },
        "switch": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": ".*switch.*"}
          ]
        },
        "clear": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": ".*clear.*"}
          ]
        }
      },
      "extend_events_until": {"column": "trial_type", "match": "regex", "value": "view_.*"},
      "equalize_trial_length": true
    },

    "timecourse_decoding": {
      "conditions": {
        "maintain": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": ".*maintain.*"}
          ]
        },
        "suppress": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": ".*suppress.*"}
          ]
        },
        "switch": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": ".*switch.*"}
          ]
        },
        "clear": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": ".*clear.*"}
          ]
        }
      },
      "trial_start_event": {"column": "trial_type", "match": "regex", "value": "view_.*"},
      "annotation_labels": {
        "view": ["view_face", "view_place"],
        "operation": ["maintain_face", "suppress_face", "switch_face", "clear_face", "maintain_place", "suppress_place", "switch_place", "clear_place"]
      },
      "overlay": {
        "face_pos": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*face.*"},
            {"column": "task", "match": "exact", "value": "WMpos"}
          ],
          "color": 0, "group": "pos"
        },
        "face_neg": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*face.*"},
            {"column": "task", "match": "exact", "value": "WMneg"}
          ],
          "color": 0, "group": "neg"
        },
        "place_pos": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*place.*"},
            {"column": "task", "match": "exact", "value": "WMpos"}
          ],
          "color": 1, "group": "pos"
        },
        "place_neg": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*place.*"},
            {"column": "task", "match": "exact", "value": "WMneg"}
          ],
          "color": 1, "group": "neg"
        }
      }
    }
  },

  "model": {
    "desc": "gm_operation_iti_liblin_onevrest_kfold_classifier",
    "mnispace": true,
    "mask": {
      "mask_pattern": "/pl/active/banich/studies/Clearvale/masks/bin_wager_gm_mask_3mm.nii.gz"
    },
    "featureSelection": {
      "model": "ANOVA",
      "feat_p": 0.05
    },
    "classifier": {
      "name": "sklearn.linear_model.LogisticRegression",
      "params": {
        "penalty": "l2",
        "C": 50,
        "solver": "liblinear",
        "max_iter": 10000,
        "class_weight": "balanced",
        "random_state": 6100
      },
      "one_vs_rest": true,
      "evidence": "sigmoid"
    },
    "kfold_cv": {
      "strategy": "explicit_groups",
      "held_out_runs": [[1, 3], [2, 4], [5, 7], [6, 8]]
    }
  },

  "master": {
    "scripts_dir": "/pl/active/banich/studies/Clearvale/scripts/mvpa-decoding",
    "bids_hcp_root": "/pl/active/banich/studies/Clearvale/analysis/bids-hcp",
    "hcppipe_root": "/pl/active/banich/studies/Clearvale/analysis/HCPPipe",
    "group_gm_mask": "/pl/active/banich/studies/Clearvale/analysis/feat/group-analyses/bin_wager_gm_mask.nii.gz",
    "output_dir": "/pl/active/banich/studies/Clearvale/analysis/mvpa-decoding",
    "master_spreadsheet": "/pl/active/banich/studies/Clearvale/analysis/mvpa-decoding/master_spreadsheet.csv"
  }
}
