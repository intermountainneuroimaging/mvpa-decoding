{
  "config_version": "1.0",
  "created_by": "AKH",
  "notes": "Clearvale MVPA face/place/item category classifier, trained on the localizer ('loc') task and applied to the working-memory tasks (WMpos/WMneg). Full run with this one config, in order: stage 2 builds the master spreadsheet, stage 2b builds the balanced training-trial list (restrict_master_spreadsheet.py, this config's lag 4.6), stage 3 trains and evaluates each subject, stage 4 builds the group report. Key settings: event_extraction.hemodynamic_lag 4.6 s; mask = vvps temporal ROI (3 mm, MNI space, mnispace true); ANOVA feature selection at p < 0.05; model.kfold_cv per_run (leave one acquisition out); 1000-permutation significance test (seed 0); testing = WM view_face/view_place trials; timecourse decoding anchored on view_* with pos/neg overlay blocks in the report. THIS VERSION: same classifier as the liblin_onevrest model (one-vs-rest logistic regression, liblinear, C = 50, balanced class weights, random_state 6100, sigmoid evidence) plus BALANCED TRAINING: model_conditions.training.trial_restriction points to the stage-2b list (face, place and item balanced to 54 trials each per subject, face and place 27 pos / 27 neg, 4 TRs per trial). Only training is restricted; the held-out test and timecourse decoding are unrestricted. Results folder: vvps_category_loc2WM_timecourse_liblin_onevrest_fullyrestricted_classifier. Build the trial list first (stage 2b) with configs/restriction.clearvale-category.json, then run stage 3 with this config. Every key, and the restriction file, is commented in config.clearvale-category-valence-groups.ANNOTATED.md.",

  "event_extraction": {
    "bids_root": "/pl/active/banich/studies/Clearvale/bids/",
    "events_glob": "**/*_events.tsv",
    "derivatives_root": "/pl/active/banich/studies/Clearvale/analysis/bids-hcp/",
    "bold_glob": "sub-{subject}/ses-{session}/func/sub-{subject}_ses-{session}_task-{task}_dir-{dir}_run-{run}_space-MNI152NLin6Asym_desc-preproc_bold.nii.gz",
    "hemodynamic_lag": 4.6,
    "output_file": "master_spreadsheet.csv"
  },
"model_conditions": {
    "training": {
      "conditions": {
        "face": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*face.*"}
          ]
        },
        "place": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*place.*"}
          ]
        },
        "item": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*item.*"}
          ]
        }
      },
      "trial_restriction": "/pl/active/banich/studies/Clearvale/analysis/mvpa-decoding/master_spreadsheet_trial_restriction.csv"
    },

    "testing": {
      "conditions": {
        "face": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": "view_face"}
          ]
        },
        "place": {
          "and": [
            {"column": "task", "match": "regex", "value": "^WM.*"},
            {"column": "trial_type", "match": "regex", "value": "view_place"}
          ]
        }
      }
    },

    "timecourse_decoding": {
      "trial_start_event": {"column": "trial_type", "match": "regex", "value": "view_.*"},
      "annotation_labels": {
        "view": ["view_face", "view_place"],
        "operation": ["maintain_face", "suppress_face", "switch_face", "clear_face", "maintain_place", "suppress_place", "switch_place", "clear_place"]
      },
      "overlay": {
        "maintain_pos": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*maintain.*"},
            {"column": "task", "match": "exact", "value": "WMpos"}
          ],
          "color": "green", "group": "pos"
        },
        "maintain_neg": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*maintain.*"},
            {"column": "task", "match": "exact", "value": "WMneg"}
          ],
          "color": "green", "group": "neg"
        },
        "suppress_pos": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*suppress.*"},
            {"column": "task", "match": "exact", "value": "WMpos"}
          ],
          "color": "red", "group": "pos"
        },
        "suppress_neg": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*suppress.*"},
            {"column": "task", "match": "exact", "value": "WMneg"}
          ],
          "color": "red", "group": "neg"
        },
        "switch_pos": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*switch.*"},
            {"column": "task", "match": "exact", "value": "WMpos"}
          ],
          "color": "blue", "group": "pos"
        },
        "switch_neg": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*switch.*"},
            {"column": "task", "match": "exact", "value": "WMneg"}
          ],
          "color": "blue", "group": "neg"
        },
        "clear_pos": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*clear.*"},
            {"column": "task", "match": "exact", "value": "WMpos"}
          ],
          "color": "orange", "group": "pos"
        },
        "clear_neg": {
          "and": [
            {"column": "trial_type", "match": "regex", "value": ".*clear.*"},
            {"column": "task", "match": "exact", "value": "WMneg"}
          ],
          "color": "orange", "group": "neg"
        }
      }
    }
  },


  "model": {
    "desc": "vvps_category_loc2WM_timecourse_liblin_onevrest_fullyrestricted_classifier",
    "mnispace": true,
    "mask": {
      "mask_pattern": "/pl/active/banich/studies/Clearvale/masks/mask_vvps_temporal_3mm.nii.gz"
    },
    "featureSelection": {
      "model": "ANOVA",
      "feat_p": 0.05
    },
    "classifier": {
      "name": "sklearn.linear_model.LogisticRegression",
      "params": {
        "penalty": "l2",
        "C": 50,
        "solver": "liblinear",
        "max_iter": 10000,
        "class_weight": "balanced",
        "random_state": 6100
      },
      "one_vs_rest": true,
      "evidence": "sigmoid"
    },
    "kfold_cv": {
      "strategy": "per_run"
    },
    "permutation_test": {
      "n_permutations": 1000,
      "random_state": 0
    }
  },

  "master": {
    "scripts_dir": "/pl/active/banich/studies/Clearvale/scripts/mvpa-decoding",
    "bids_hcp_root": "/pl/active/banich/studies/Clearvale/analysis/bids-hcp",
    "hcppipe_root": "/pl/active/banich/studies/Clearvale/analysis/HCPPipe",
    "group_gm_mask": "/pl/active/banich/studies/Clearvale/analysis/feat/group-analyses/bin_wager_gm_mask.nii.gz",
    "output_dir": "/pl/active/banich/studies/Clearvale/analysis/mvpa-decoding",
    "master_spreadsheet": "/pl/active/banich/studies/Clearvale/analysis/mvpa-decoding/master_spreadsheet.csv"
  }
}
