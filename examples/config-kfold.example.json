{
  "config_version": "1.0",
  "created_by": "AKH",
  "notes": "MVPA face/place, k-fold (same-task, split by run) -- for mvpa_workflow.py's model.kfold_cv step. model_conditions.testing/timecourse_decoding are byte-identical to training (same query, no run restriction) by design: model.kfold_cv resolves fold membership -- and the actual train/held-out run split -- entirely from model_conditions.training on its own, so testing/timecourse_decoding just re-list the same eligible rows for their own steps. Since testing is now independently optional (see README.md section 4), leaving it in also makes mvpa_workflow.py run its separate fit-on-all-training/evaluate-on-all-testing step -- and because testing's query matches the exact same rows training does (no held-out split), that step here just re-scores the classifier on data it was already fit on, not a genuine held-out generalization test. Remove model_conditions.testing if you only want the k-fold (model/) output demonstrated by this example.",

  "event_extraction": {
    "bids_root": "examples/sample-data",
    "events_glob": "**/*_events.tsv",
    "hemodynamic_lag": 4.6,
    "output_file": "master_spreadsheet.csv",
    "expected_events_file": "examples/expected_events.example.json"
  },

  "model_conditions": {
    "training": {
      "conditions": {
        "face": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*face.*"}
          ]
        },
        "place": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*place.*"}
          ]
        }
      }
    },

    "testing": {
      "conditions": {
        "face": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*face.*"}
          ]
        },
        "place": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*place.*"}
          ]
        }
      }
    },

    "timecourse_decoding": {
      "conditions": {
        "face": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*face.*"}
          ]
        },
        "place": {
          "and": [
            {"column": "task", "match": "exact", "value": "loc"},
            {"column": "trial_type", "match": "regex", "value": ".*place.*"}
          ]
        }
      },
      "window": {
        "start": {"reference": "onset", "offset_seconds": 0},
        "end": {"reference": "offset_end", "offset_seconds": 10}
      }
    }
  },

  "model": {
    "desc": "gm_object_kfold_classifier",
    "mask": {
      "mask_pattern": "examples/sample-data/sub-{subject}/ses-{session}/masks/native_gm_transformed_mask.nii.gz"
    },
    "featureSelection": {
      "model": "ANOVA",
      "feat_p": 0.05
    },
    "classifier": {
      "name": "sklearn.linear_model.LogisticRegression",
      "params": {
        "penalty": "l2",
        "C": 0.5,
        "solver": "lbfgs",
        "max_iter": 10000,
        "class_weight": "balanced"
      }
    },
    "kfold_cv": {
      "strategy": "per_run"
    },
    "permutation_test": {
      "n_permutations": 1000,
      "random_state": 0
    }
  },

  "pipeline": {
    "_comment": "Only read by slurm/resolve_pipeline_config.sh -- irrelevant to running mvpa_workflow.py/generate_report.py directly (as this example's own README section does). Every path here is a full, already-resolved absolute path -- see README.md section 9.",
    "scripts_dir": "/path/to/mvpa-decoding",
    "bids_hcp_root": "/path/to/study/bids-hcp",
    "hcppipe_root": "/path/to/study/HCPPipe",
    "group_gm_mask": "/path/to/study/masks/group_gm_mask.nii.gz",
    "output_dir": "/path/to/study/mvpa-decoding",
    "master_spreadsheet": "/path/to/study/mvpa-decoding/master_spreadsheet.csv"
  }
}
